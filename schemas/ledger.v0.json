{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger.v0.json",
  "$defs": {
    "LedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "episode": {
          "pattern": "^E\\d{2}-[a-z0-9][a-z0-9-]*$",
          "title": "Episode",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "segments": {
          "items": {
            "pattern": "^s\\d+-[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Segments",
          "type": "array"
        },
        "establishes": {
          "items": {
            "pattern": "^(term|idea|visual):[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Establishes",
          "type": "array"
        }
      },
      "required": [
        "episode",
        "title",
        "segments",
        "establishes"
      ],
      "title": "LedgerEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What each built episode of a series teaches, for later episodes to build on.",
  "properties": {
    "format": {
      "const": "ledger/v0",
      "title": "Format",
      "type": "string"
    },
    "series": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Series",
      "type": "string"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/LedgerEntry"
      },
      "title": "Episodes",
      "type": "array"
    }
  },
  "required": [
    "format",
    "series",
    "episodes"
  ],
  "title": "LedgerV0",
  "type": "object"
}
