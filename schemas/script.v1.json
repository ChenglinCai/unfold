{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "script.v1.json",
  "$defs": {
    "Beat": {
      "additionalProperties": false,
      "properties": {
        "cue": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Cue",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "cue",
        "text"
      ],
      "title": "Beat",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A script whose front matter maps each cue to the anchors of its beat.",
  "properties": {
    "format": {
      "const": "script/v1",
      "title": "Format",
      "type": "string"
    },
    "episode": {
      "pattern": "^E\\d{2}-[a-z0-9][a-z0-9-]*$",
      "title": "Episode",
      "type": "string"
    },
    "segment": {
      "pattern": "^s\\d+-[a-z0-9][a-z0-9-]*$",
      "title": "Segment",
      "type": "string"
    },
    "voice": {
      "minLength": 1,
      "title": "Voice",
      "type": "string"
    },
    "written_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Written By"
    },
    "anchors": {
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*#[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Anchors",
      "type": "object"
    },
    "beats": {
      "items": {
        "$ref": "#/$defs/Beat"
      },
      "minItems": 1,
      "title": "Beats",
      "type": "array"
    }
  },
  "required": [
    "format",
    "episode",
    "segment",
    "voice",
    "anchors",
    "beats"
  ],
  "title": "ScriptV1",
  "type": "object"
}
