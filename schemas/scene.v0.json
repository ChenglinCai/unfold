{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene.v0.json",
  "$defs": {
    "BarChart": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "bar-chart",
          "title": "Component",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "highlight": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlight"
        }
      },
      "required": [
        "component",
        "labels",
        "values"
      ],
      "title": "BarChart",
      "type": "object"
    },
    "ComplexPlane": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "complex-plane",
          "title": "Component",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/PlanePoint"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "unit_circle": {
          "default": true,
          "title": "Unit Circle",
          "type": "boolean"
        },
        "rays": {
          "default": true,
          "title": "Rays",
          "type": "boolean"
        },
        "turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/Turn"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "component",
        "points"
      ],
      "title": "ComplexPlane",
      "type": "object"
    },
    "Custom": {
      "additionalProperties": false,
      "description": "A visual that no component draws yet. It renders as a labeled card.",
      "properties": {
        "component": {
          "const": "custom",
          "title": "Component",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "component",
        "description"
      ],
      "title": "Custom",
      "type": "object"
    },
    "Equation": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "equation",
          "title": "Component",
          "type": "string"
        },
        "tex": {
          "minLength": 1,
          "title": "Tex",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "component",
        "tex"
      ],
      "title": "Equation",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "title": "At",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        }
      },
      "required": [
        "at",
        "label"
      ],
      "title": "Event",
      "type": "object"
    },
    "Flow": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "maximum": 100,
          "minimum": 0,
          "title": "At",
          "type": "number"
        },
        "amount": {
          "title": "Amount",
          "type": "number"
        }
      },
      "required": [
        "at",
        "amount"
      ],
      "title": "Flow",
      "type": "object"
    },
    "PlanePoint": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "radius": {
          "maximum": 100,
          "minimum": 0,
          "title": "Radius",
          "type": "number"
        },
        "angle": {
          "title": "Angle",
          "type": "number"
        },
        "guides": {
          "default": false,
          "title": "Guides",
          "type": "boolean"
        },
        "real_label": {
          "default": "",
          "title": "Real Label",
          "type": "string"
        },
        "imag_label": {
          "default": "",
          "title": "Imag Label",
          "type": "string"
        }
      },
      "required": [
        "radius",
        "angle"
      ],
      "title": "PlanePoint",
      "type": "object"
    },
    "PresentValue": {
      "additionalProperties": false,
      "description": "Cash flows, and what each is worth today. Code computes every present value.",
      "properties": {
        "component": {
          "const": "present-value",
          "title": "Component",
          "type": "string"
        },
        "rate": {
          "maximum": 100,
          "minimum": 0,
          "title": "Rate",
          "type": "number"
        },
        "flows": {
          "items": {
            "$ref": "#/$defs/Flow"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Flows",
          "type": "array"
        },
        "total": {
          "default": true,
          "title": "Total",
          "type": "boolean"
        },
        "prefix": {
          "default": "",
          "maxLength": 3,
          "title": "Prefix",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "component",
        "rate",
        "flows"
      ],
      "title": "PresentValue",
      "type": "object"
    },
    "ScatterPlot": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "scatter-plot",
          "title": "Component",
          "type": "string"
        },
        "points": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 60,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "groups": {
          "items": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Groups",
          "type": "array"
        },
        "x_label": {
          "default": "",
          "title": "X Label",
          "type": "string"
        },
        "y_label": {
          "default": "",
          "title": "Y Label",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "required": [
        "component",
        "points"
      ],
      "title": "ScatterPlot",
      "type": "object"
    },
    "SceneEntry": {
      "additionalProperties": false,
      "properties": {
        "cue": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Cue",
          "type": "string"
        },
        "region": {
          "enum": [
            "full",
            "plot",
            "top",
            "bottom",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "visual": {
          "discriminator": {
            "mapping": {
              "bar-chart": "#/$defs/BarChart",
              "complex-plane": "#/$defs/ComplexPlane",
              "custom": "#/$defs/Custom",
              "equation": "#/$defs/Equation",
              "present-value": "#/$defs/PresentValue",
              "scatter-plot": "#/$defs/ScatterPlot",
              "text-card": "#/$defs/TextCard",
              "timeline": "#/$defs/Timeline"
            },
            "propertyName": "component"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextCard"
            },
            {
              "$ref": "#/$defs/Equation"
            },
            {
              "$ref": "#/$defs/BarChart"
            },
            {
              "$ref": "#/$defs/ScatterPlot"
            },
            {
              "$ref": "#/$defs/Timeline"
            },
            {
              "$ref": "#/$defs/ComplexPlane"
            },
            {
              "$ref": "#/$defs/PresentValue"
            },
            {
              "$ref": "#/$defs/Custom"
            }
          ],
          "title": "Visual"
        }
      },
      "required": [
        "cue",
        "region",
        "visual"
      ],
      "title": "SceneEntry",
      "type": "object"
    },
    "TextCard": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "text-card",
          "title": "Component",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "lines": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "component"
      ],
      "title": "TextCard",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "const": "timeline",
          "title": "Component",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "component",
        "start",
        "end",
        "events"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "Turn": {
      "additionalProperties": false,
      "description": "An arc with an arrow tip, from one angle to another, in degrees.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Turn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One segment's visuals: for each cue, a region and a component's parameters.",
  "properties": {
    "format": {
      "const": "scene/v0",
      "title": "Format",
      "type": "string"
    },
    "episode": {
      "pattern": "^E\\d{2}-[a-z0-9][a-z0-9-]*$",
      "title": "Episode",
      "type": "string"
    },
    "segment": {
      "pattern": "^s\\d+-[a-z0-9][a-z0-9-]*$",
      "title": "Segment",
      "type": "string"
    },
    "written_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Written By"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SceneEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "format",
    "episode",
    "segment",
    "entries"
  ],
  "title": "SceneV0",
  "type": "object"
}
