{
  "name": "unfold",
  "version": "0.1.0",
  "description": "Turn learning material into explainer videos, with checked scripts, scenes, and voices.",
  "author": { "name": "ChenglinCai" },
  "homepage": "https://github.com/ChenglinCai/unfold",
  "repository": "https://github.com/ChenglinCai/unfold",
  "license": "MIT",
  "keywords": ["education", "video", "manim", "explainer"],
  "mcpServers": {
    "unfold": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "unfold[audio,mcp] @ git+https://github.com/ChenglinCai/unfold",
        "unfold",
        "mcp"
      ]
    }
  }
}
